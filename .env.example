# ──────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your own keys.
#  `.env` is gitignored and never committed.
#
#  All keys are optional — the app degrades gracefully:
#    • No GROQ key  → keyword-only scoring (Stage 1), no AI re-rank
#    • No ADZUNA    → skips the Adzuna aggregator, other sources still run
#    • No RESEND    → the daily digest email is simply not sent
# ──────────────────────────────────────────────────────────────

# Groq — free LLM used to re-rank shortlisted jobs against your profile.
# Get a key at https://console.groq.com  (API Keys)
GROQ_API_KEY=

# Adzuna — broad job-search aggregator. Free dev credentials at
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Resend — sends the daily digest email. Free tier at https://resend.com
RESEND_API_KEY=
